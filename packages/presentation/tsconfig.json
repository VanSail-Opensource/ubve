{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable",
      "ESNext.Disposable"
    ],
    "types": [
      "@webgpu/types"
    ],
    "skipLibCheck": true
  },
  "references": [
    {
      "path": "../core"
    }
  ],
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.worker.ts",
    "src/**/*.worklet.ts"
  ]
}
