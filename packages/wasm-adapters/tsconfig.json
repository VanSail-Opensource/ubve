{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "lib": [
      "ES2023",
      "DOM",
      "ESNext.Disposable"
    ],
    "skipLibCheck": true
  },
  "references": [
    {
      "path": "../core"
    },
    {
      "path": "../io-demux"
    }
  ],
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.worker.ts",
    "src/**/*.worklet.ts"
  ]
}
