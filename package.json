{
  "name": "ubve",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.12.0 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check": "npm run check:types && npm run check:boundaries",
    "check:types": "tsc -p packages/core --noEmit --pretty false && npm run build",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "build": "tsc -b packages/core packages/testkit packages/browser packages/io-demux packages/presentation packages/wasm-adapters packages/native-bridge --pretty false && tsc -p packages/presentation/tsconfig.worklet.json --pretty false",
    "test:unit": "npm run build && node --test test/*.test.mjs",
    "test": "npm run check && npm run test:unit",
    "test:io": "tsc -b packages/io-demux --pretty false && node --test test/io-demux.test.mjs",
    "test:http": "tsc -b packages/io-demux --pretty false && node --test test/http-source.test.mjs",
    "build:presentation": "node scripts/prepare-presentation-assets.mjs",
    "test:presentation:browser": "node test/presentation-browser.mjs",
    "build:codecs": "node scripts/build-codecs.mjs",
    "test:codecs": "npm run build && npm run build:codecs && node --test test/codec-lifecycle.test.mjs test/codecs-node.evidence.mjs",
    "test:native:wasm": "tsc -b packages/native-bridge --pretty false && node --test test/native-bridge.test.mjs",
    "test:native:browser": "node test/native-bridge-browser.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.11",
    "@webgpu/types": "0.1.74",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vue-tsc": "3.3.14"
  },
  "dependencies": {
    "@libmedia/avutil": "1.3.1",
    "@libmedia/cheap": "1.3.1",
    "@libmedia/common": "2.3.0",
    "@mediabunny/flac-encoder": "1.66.4",
    "@mediabunny/truehd": "1.66.4",
    "imsc": "2.0.0",
    "jassub": "2.5.38",
    "mediabunny": "1.66.4",
    "vue": "3.5.46"
  }
}
